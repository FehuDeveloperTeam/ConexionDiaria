//
// REGLAS DE SEGURIDAD PARA CONEXIÓN DIARIA
//
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA ---

    // ¿Está el usuario autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }

    // ¿Es el usuario el dueño de este documento?
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ¿Pertenece el usuario a esta relación?
    // (El ID de la relación es 'uid1_uid2')
    function isInRelationship(relationshipId) {
      return isAuthenticated() && request.auth.uid in relationshipId.split('_');
    }

    // ¿Es el usuario el autor del *nuevo* dato que se está creando?
    function isAuthorOfNewData() {
      return isAuthenticated() && request.resource.data.authorId == request.auth.uid;
    }

    // ¿Es el usuario el autor del dato que *ya existe*? (para editar/borrar)
    function isAuthorOfExistingData() {
      return isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Verificar si el usuario es pareja del perfil
    function isPartner(userId) {
      return isAuthenticated() &&
             resource.data.partnerId != null &&
             request.auth.uid == resource.data.partnerId;
    }

    // ¿El documento de destino me tiene HOY como pareja? Se usa para
    // desconectar, y para escribir campos compartidos como la fecha de
    // aniversario en el documento del otro.
    function isCurrentPartnerOf() {
      return isAuthenticated() && resource.data.partnerId == request.auth.uid;
    }

    // ¿Estoy reclamando a esta persona como mi pareja, y ella no tenía
    // pareja todavía? (paso de 'conectar' que toca el documento ajeno)
    function isClaimingAsPartner() {
      return isAuthenticated()
        && resource.data.partnerId == null
        && request.resource.data.partnerId == request.auth.uid;
    }

    // ¿Estoy liberando a esta persona de ser mi pareja? (paso de
    // 'desconectar' que toca el documento ajeno)
    function isReleasingAsPartner() {
      return isCurrentPartnerOf() && request.resource.data.partnerId == null;
    }

    // ¿La escritura toca EXCLUSIVAMENTE estos campos? Así una excepción para
    // "escribir el documento ajeno" no se puede usar de paso para tocar
    // cualquier otro campo del perfil.
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ¿La escritura toca 'plan' o 'premiumSince'? Esos dos campos son de
    // solo lectura para cualquier cliente — los escribe exclusivamente la
    // Cloud Function que valida el webhook de RevenueCat, vía Admin SDK
    // (que nunca pasa por estas reglas, así que no necesita una excepción
    // aquí). Antes de esto, cualquier usuario podía autoasignarse premium.
    function touchesLockedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'premiumSince']);
    }

    // Mismo espíritu que touchesLockedFields(), pero para 'create': ahí no
    // existe 'resource' (el documento previo) para hacer diff, así que se
    // valida el valor inicial directamente — nadie puede crear su propio
    // perfil ya en premium.
    function createsWithoutPremium() {
      return request.resource.data.plan == 'free' && request.resource.data.premiumSince == null;
    }

    // --- REGLAS PARA LA COLECCIÓN 'users' ---
    match /users/{userId} {

      // Solo tú y tu pareja pueden leer tu perfil
      allow read: if isUser(userId) || isPartner(userId);

      // Solo tú puedes crear tu propio perfil, y solo en plan free.
      allow create: if isUser(userId) && createsWithoutPremium();

      // Solo tú puedes actualizar tu propio perfil libremente (mood, name,
      // photoURL, partnerId propio, invitationCode, etc.) — excepto 'plan'
      // y 'premiumSince', bloqueados para todo cliente. Además, dos
      // excepciones acotadas para tocar el documento AJENO, cada una
      // restringida a un único campo y a una condición previa específica:
      allow update: if (isUser(userId) && !touchesLockedFields())
        // Conectar o desconectar pareja: solo el campo 'partnerId', y solo
        // reclamando a alguien libre o liberando a quien me tiene como pareja.
        || (onlyFieldsChanged(['partnerId']) && (isClaimingAsPartner() || isReleasingAsPartner()))
        // Fecha de aniversario compartida: solo entre pareja actual.
        || (onlyFieldsChanged(['relationshipStartDate']) && isCurrentPartnerOf());

      // Nadie puede borrar perfiles
      allow delete: if false;
    }

    // --- REGLAS PARA LA COLECCIÓN 'invitationCodes' ---
    // Mapeo público código -> uid, para emparejar sin tener que leer el
    // perfil privado del otro usuario (ver Sprint 2 / src/services/invitationCode.ts).
    // El documento solo contiene { uid, createdAt } — nada personal.
    match /invitationCodes/{code} {
      // Cualquier usuario autenticado puede resolver un código.
      allow read: if isAuthenticated();

      // Solo se crea al registrarse, y solo apuntando a uno mismo.
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // Inmutable: no se reescribe ni se borra desde el cliente.
      allow update, delete: if false;
    }

    // --- REGLAS PARA LA COLECCIÓN 'relationships' ---
    // (Contiene todos los datos compartidos)
    match /relationships/{relationshipId} {

      // SOLO los 2 usuarios de la relación pueden leer o escribir el documento principal
      allow read, write: if isInRelationship(relationshipId);

      // --- SUB-COLECCIÓN: Chat ('messages') ---
      match /messages/{messageId} {
        // [Chat] Solo los 2 usuarios pueden leer y crear mensajes
        allow read, create: if isInRelationship(relationshipId);

        // [Chat] Solo el autor puede eliminar su propio mensaje
        allow delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();

        // [Chat] Dos únicas formas de editar un mensaje ya creado:
        // - Confirmación de entrega/lectura: cualquiera de los dos, y solo
        //   esos dos campos (así no sirve para tocar el contenido).
        // - Borrado suave del propio mensaje: solo el autor, solo para
        //   marcarlo borrado (no para "des-borrarlo").
        allow update: if isInRelationship(relationshipId) && (
          onlyFieldsChanged(['delivered', 'read', 'audioPlayed']) ||
          (isAuthorOfExistingData() && onlyFieldsChanged(['deleted']) && request.resource.data.deleted == true)
        );
      }

      // --- SUB-COLECCIÓN: Álbum ('photos') ---
      match /photos/{photoId} {
        // [Álbum] Solo los 2 usuarios pueden leer fotos
        allow read: if isInRelationship(relationshipId);

        // [Álbum] Solo puedes crear fotos si eres el autor
        allow create: if isInRelationship(relationshipId) && isAuthorOfNewData();

        // [Álbum] Solo el autor puede eliminar su propia foto
        allow delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();

        allow update: if false; // No se pueden editar
      }

      // --- SUB-COLECCIÓN: Notas ('notes') ---
      match /notes/{noteId} {
        // [Notas] Solo los 2 usuarios pueden leer notas
        allow read: if isInRelationship(relationshipId);

        // [Notas] Solo puedes crear notas si eres el autor
        allow create: if isInRelationship(relationshipId) && isAuthorOfNewData();

        // [Notas] Solo el autor puede editar o borrar su propia nota
        allow update, delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();
      }

      // --- SUB-COLECCIÓN: Calendario ('events') ---
      match /events/{eventId} {
        // [Calendario] Solo los 2 usuarios pueden leer eventos
        allow read: if isInRelationship(relationshipId);

        // [Calendario] Solo puedes crear eventos si eres el autor
        allow create: if isInRelationship(relationshipId) && isAuthorOfNewData();

        // [Calendario] Solo el autor puede editar o borrar su propio evento
        allow update, delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();
      }

      // --- SUB-COLECCIÓN: Tareas ('tasks') ---
      match /tasks/{taskId} {
        // [Tareas] Cualquiera en la relación puede leer, crear y actualizar (marcar como completada)
        allow read, create, update: if isInRelationship(relationshipId);

        // [Tareas] Solo el autor puede borrarla
        allow delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();
      }

      // --- SUB-COLECCIÓN: Lista de Deseos ('wishlist') ---
      match /wishlist/{wishId} {
        // [Deseos] Cualquiera en la relación puede leer, crear y actualizar (marcar como "comprado")
        allow read, create, update: if isInRelationship(relationshipId);

        // [Deseos] Solo el autor puede borrar su propio deseo
        allow delete: if isInRelationship(relationshipId) && isAuthorOfExistingData();
      }

      // --- SUB-COLECCIÓN: Historial "Te Extraño" ---
      match /missYouHistory/{dateId} {
        // [Home] Cualquiera en la relación puede leer y escribir (actualizar su contador)
        allow read, write: if isInRelationship(relationshipId);
      }

      // --- SUB-COLECCIÓN: Avisos "Te Extraño" (Sprint 5.2) ---
      // Un documento por cada "te extraño" enviado, solo para que la Cloud
      // Function que manda el push a la pareja tenga un evento de creación
      // limpio del cual dispararse. Inmutable: se crea y no se vuelve a tocar.
      match /missYouPings/{pingId} {
        allow read: if isInRelationship(relationshipId);
        allow create: if isInRelationship(relationshipId) && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}

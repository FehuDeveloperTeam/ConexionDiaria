# Copia este archivo a .env y completa los valores reales.
# .env no se sube al repositorio (ver .gitignore).
#
# Estas son variables EXPO_PUBLIC_*: Expo las inyecta directo en el bundle
# de JS en tiempo de build. NO son secretas — son la misma configuración
# de Firebase que ya viaja hoy embebida en la app. Se externalizan para
# poder tener distintos proyectos de Firebase (dev/staging/prod) sin tocar
# código, y para que nada quede hardcodeado en el repo.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Clave pública del SDK de RevenueCat (no confundir con la API key secreta
# del backend de RevenueCat, que nunca debe estar en el cliente).
EXPO_PUBLIC_REVENUECAT_API_KEY=
